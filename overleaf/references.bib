@inproceedings{satouRevampingCockpitLatest2024,
	title = {Revamping the {Cockpit}: {Latest} {Trends} in {Automotive} {E}/{E} {Architecture}, {Central} {Computers}, {In}-vehicle {Infotainment} {Systems} and {Displays}},
	shorttitle = {Revamping the {Cockpit}},
	url = {https://ieeexplore.ieee.org/document/10615426},
	doi = {10.23919/AM-FPD61635.2024.10615426},
	abstract = {The automotive industry is undergoing a massive transformation driven by advancements in electrical drives, automated driving, and software-defined vehicles. This report explores the impact of these technologies on the upcoming E/E architecture of these vehicles. The paper focuses on the capabilities of high-performance computers, their multiple interfaces and resulting computational requirements. Additionally, the importance of human-machine interface (HMI) and the emergence of new display technologies in the automotive sector will be discussed. Examples for recently introduced and upcoming new display types are explained.},
	urldate = {2026-07-03},
	booktitle = {2024 31st {International} {Workshop} on {Active}-{Matrix} {Flatpanel} {Displays} and {Devices} ({AM}-{FPD})},
	author = {Satou, Ichirou and Schmidt, Martin},
	month = jul,
	year = {2024},
	keywords = {HMIs},
	pages = {01--04},
}

@inproceedings{itoHighPerformanceInteractiveDisplay2022,
	title = {High-{Performance} {Interactive} {Display} {Technologies} for {Automotive} {Applications}},
