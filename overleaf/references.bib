	doi = {10.23919/AM-FPD54920.2022.9851359},
	abstract = {With the digitization of automotive cockpits, the technological trends of cockpit displays have been changing dramatically. To respond to these changes, we have developed new display technologies featuring large sizes, high definition, freeform shapes, and curved shapes, as well as interactive technologies for recognizing touch and gesture. In this paper, we present the ultra-high-contrast LCD technology (ACRUS) and the gesture recognition technology we have developed.},
